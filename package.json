{
  "name": "tailwind-g-watch",
  "version": "0.0.8",
  "description": "tailwind global watch",
  "main": "src/build.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/highk/tailwind-g-watch.git"
  },
  "bugs": {
    "url": "https://github.com/highk/tailwind-g-watch/issues"
  },
  "homepage": "https://github.com/highk/tailwind-g-watch#readme",
  "files": [
    "bin",
    "docs",
    "scripts",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.12.0"
  },
  "scripts": {
    "ci": "npm test && node test/dogfood-missing-module.js && npm run test:pack",
    "test": "npm run test:help && npm run test:build",
    "test:build": "npm run test:build:v3 && npm run test:build:v4 && npm run test:build:v4:cli",
    "test:build:v3": "node test/smoke-build-v3.js",
    "test:build:v4": "node test/smoke-build-v4.js",
    "test:build:v4:cli": "node test/smoke-cli-v4.js",
    "test:help": "node bin/cli.js --help && node scripts/watch.js --help",
    "test:pack": "npm pack --dry-run",
    "watch": "node scripts/watch.js",
    "build": "NODE_ENV=production node scripts/watch.js"
  },
  "bin": {
    "tailwind-g-watch": "./bin/cli.js"
  },
  "keywords": [
    "tailwindcss",
    "css"
  ],
  "author": "superfast",
  "license": "MIT",
  "dependencies": {
    "@csstools/postcss-sass": "^5.1.1",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/line-clamp": "^0.4.4",
    "@tailwindcss/typography": "^0.5.10",
    "autoprefixer": "^10.4.17",
    "chokidar": "^3.5.3",
    "cssnano": "^6.0.3",
    "cssnano-preset-default": "^6.0.3",
    "postcss": "^8.4.33",
    "postcss-cli": "^11.0.0",
    "postcss-discard-comments": "^6.0.1",
    "postcss-import": "^16.0.0",
    "postcss-nested": "^6.0.1",
    "postcss-preset-env": "^9.3.0",
    "postcss-reporter": "^7.1.0",
    "postcss-scss": "^4.0.9",
    "stylelint": "^16.2.0",
    "stylelint-config-standard": "^36.0.0",
    "stylelint-scss": "^6.1.0",
    "tailwindcss": "^3.4.1",
    "yargs": "^17.7.2"
  },
  "optionalDependencies": {
    "@tailwindcss/postcss": "^4.3.0"
  }
}
